<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="mrp_bom_list_location" model="ir.ui.view">
            <field name="name">mrp.bom.list.location</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="%(action_report_bom_structure_xlsx)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-file-excel-o">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Exportar<br/>Excel</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_uom_id']" position="after">
                    <field name="location_plane" string="Localizacion"/>
                </xpath>
            </field>
        </record>
        <record id="mrp_bom_line_view_form_location" model="ir.ui.view">
            <field name="name">mrp.bom.line.view.form - mrp_bom_location</field>
            <field name="model">mrp.bom.line</field>
            <field name="inherit_id" ref="mrp.mrp_bom_line_view_form"/>
            <field name="arch" type="xml">
                <field name="product_id" position="before">
                    <field name="location_plane" string="Localizacion"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
