<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="report_mrp_bom_sonelco" inherit_id="mrp.report_mrp_bom">
            <xpath expr="//table/thead/tr/th[last()]" position="after">
                <th>Localizacion</th>
            </xpath>
            <xpath expr="//tbody/tr/td[last()]" position="after">
                <td/>
            </xpath>
            <xpath expr="//tfoot/tr[1]/td[last()]" position="after">
                <td/>
            </xpath>
            <xpath expr="//tfoot/t/tr/td[last()]" position="after">
                <td/>
            </xpath>
        </template>

        <template id="report_mrp_bom_line_sonelco" inherit_id="mrp.report_mrp_bom_pdf_line">
            <xpath expr="//tr/td[last()]" position="after">
                <td>
                    <span t-if="l['type'] in ('component', 'bom')" t-esc="l.get('location_plane', '')"/>
                </td>
            </xpath>
        </template>
    </data>
</odoo>
