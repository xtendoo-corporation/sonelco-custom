<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <template id="report_rma_document_sonelco"
                  inherit_id="rma.report_rma_document">

            <!-- Reemplazar el div de general_information para agregar mejor espaciado -->
            <xpath expr="//div[@id='general_information']" position="replace">
                <div id="general_information" class="d-flex flex-wrap justify-content-between mt-4 mb-4" style="width: 100%;">
                    <div t-if="doc.origin" class="mb-2" style="min-width: 100px;">
                        <strong>Referencia:</strong>
                        <p class="m-0" t-field="doc.origin"/>
                    </div>
                    <div class="mb-2" style="min-width: 100px;">
                        <strong>Fecha:</strong>
                        <p class="m-0" t-field="doc.date"/>
                    </div>
                    <div t-if="doc.deadline" class="mb-2" style="min-width: 100px;">
                        <strong>Fecha límite:</strong>
                        <p class="m-0" t-field="doc.deadline"/>
                    </div>
                    <div t-if="doc.user_id" class="mb-2" style="min-width: 120px;">
                        <strong>Responsable:</strong>
                        <p class="m-0" t-field="doc.user_id"/>
                    </div>
                    <div class="mb-2" style="min-width: 100px;">
                        <strong>Estado:</strong>
                        <p class="m-0">
                            <t t-if="doc.state in ['refunded', 'replaced', 'returned']">
                                <span class="small text-success">
                                    <i class="fa fa-fw fa-check"/>
                                    <b><span t-field="doc.state"/></b>
                                </span>
                            </t>
                            <t t-elif="doc.state in ['cancelled', 'locked']">
                                <span class="small text-danger">
                                    <i class="fa fa-fw fa-times"/>
                                    <b><span t-field="doc.state"/></b>
                                </span>
                            </t>
                            <t t-else="">
                                <span class="small text-info">
                                    <i class="fa fa-fw fa-clock-o"/>
                                    <b><span t-field="doc.state"/></b>
                                </span>
                            </t>
                        </p>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
