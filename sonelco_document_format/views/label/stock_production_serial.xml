                        <record id="sonelco_document_format.product_serial_label" model="ir.actions.report">
            <field name="name">Etiqueta nº serie</field>
            <field name="model">stock.lot</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sonelco_document_format.report_product_seria_label</field>
            <field name="report_file">sonelco_document_format.report_product_seria_label</field>
            <field name="attachment"/>
            <field name="binding_model_id" eval="False"/>
        </record>
<!--        <report-->
