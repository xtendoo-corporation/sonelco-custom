<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_mrp_label_product" model="ir.actions.report">
            <field name="name">Etiqueta Producto</field>
            <field name="model">mrp.production</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sonelco_document_format.mrp_label_product_template</field>
            <field name="report_file">sonelco_document_format.mrp_label_product_template</field>
            <field name="binding_model_id" ref="mrp.model_mrp_production" />
            <field name="paperformat_id" ref="sonelco_document_format.label_papperformat" />
        </record>

        <template id="mrp_label_product_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lot_info" t-value="get_lot_code(o)" />
                    <t t-call="web.basic_layout">
                        <div class="page"
                            style="page-break-inside: avoid; page-break-after: avoid; font-family: sans-serif; margin:0; padding:0; max-height:120px; overflow:hidden;">
                            <div class="oe_structure" />

                            <!-- Tabla principal 3x3 -->
                            <table
                                style="width:100%; height:118px; max-height:118px; table-layout:fixed; border-collapse:collapse; margin:0; padding:0;">
                                <colgroup>
                                    <col style="width:33%;" />
                                    <col style="width:33%;" />
                                    <col style="width:34%;" />
                                </colgroup>

                                <!-- ═══ FILA 1: Código + Nombre + Versión | Barcode lote ═══ -->
                                <tr style="height:38px; max-height:38px; border:none;">
                                    <td colspan="2"
                                        style="vertical-align:top; text-align:left; padding:2px 4px 0 4px; overflow:hidden; max-height:38px;">
                                        <div
                                            style="font-weight:900; font-size:1.4em; line-height:1; color:#1a1a1a; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">
                                            <t t-esc="o.product_id.default_code or ''" />
                                        </div>
                                        <div
                                            style="font-size:0.6em; line-height:1; padding-top:1px; font-weight:500; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">
                                            <t
                                                t-esc="' '.join((o.product_id.name or '').split()[:5])" />
                                            <t t-if="o.product_id.x_version">, V: <t
                                                    t-esc="o.product_id.x_version" /></t>
                                            <t t-else="">, V: -</t>
                                        </div>
                                    </td>
                                    <td
                                        style="vertical-align:middle; text-align:center; padding:1px; overflow:hidden;">
                                        <div t-if="lot_info['barcode_value']"
                                            style="text-align:center;">
                                            <img
                                                t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', lot_info['barcode_value'], 400, 100)"
                                                style="width:95%; max-height:22px;" />
                                            <div t-esc="lot_info['code']"
                                                style="font-size:0.45em; letter-spacing:0.5px; text-align:center; line-height:1;" />
                                        </div>
                                    </td>
                                </tr>

                                <!-- ═══ FILA 2: Imagen producto | Barcode producto ═══ -->
                                <tr style="height:50px; max-height:50px; border:none;">
                                    <td
                                        style="vertical-align:middle; text-align:center; padding:1px; overflow:hidden;">
                                        <span t-field="o.product_id.image_1920"
                                            t-options='{"widget": "image"}'
                                            style="max-width:48px; max-height:42px; object-fit:contain; display:inline-block; vertical-align:middle;" />
                                    </td>
                                    <td colspan="2"
                                        style="vertical-align:middle; text-align:center; padding:1px 4px 1px 2px; overflow:hidden;">
                                        <div t-if="o.product_id.barcode"
                                            style="width:100%; text-align:center;">
                                            <img
                                                t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.product_id.barcode, 800, 150)"
                                                style="width:100%; max-height:24px; display:block;" />
                                            <div t-esc="o.product_id.barcode"
                                                style="font-size:0.55em; letter-spacing:1px; text-align:center; line-height:1;" />
                                        </div>
                                    </td>
                                </tr>

                                <!-- ═══ FILA 3: OF | Logo ═══ -->
                                <tr style="height:28px; max-height:28px; border:none;">
                                    <td colspan="2"
                                        style="vertical-align:middle; text-align:left; padding:1px 4px; overflow:hidden;">
                                        <div
                                            style="font-size:0.7em; font-weight:bold; white-space:nowrap; line-height:1;">
                                            OF: <t t-esc="o.name" />
                                        </div>
                                    </td>
                                    <td
                                        style="vertical-align:middle; text-align:center; padding:1px; overflow:hidden;">
                                        <img
                                            style="max-width:80%; max-height:16px; display:inline-block;"
                                            src="/sonelco_document_format/static/src/img/fav-icon-sonelco.png" />
                                        <div
                                            style="font-size:0.35em; font-weight:bold; letter-spacing:1px; line-height:1;">
                                            SONELCO</div>
                                    </td>
                                </tr>

                            </table>

                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>