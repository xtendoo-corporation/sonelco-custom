<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_mrp_label_product" model="ir.actions.report">
            <field name="name">Etiqueta Producto</field>
            <field name="model">mrp.production</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sonelco_document_format.mrp_label_product_template</field>
            <field name="report_file">sonelco_document_format.mrp_label_product_template</field>
            <field name="binding_model_id" ref="mrp.model_mrp_production" />
            <field name="paperformat_id" ref="sonelco_document_format.label_papperformat" />
        </record>

        <template id="mrp_label_product_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lot_info" t-value="get_lot_code(o)" />
                    <t t-set="qty_to_print" t-value="max(1, int(o.product_qty or 1))" />
                    <t t-call="web.basic_layout">
                        <t t-foreach="range(qty_to_print)" t-as="product_copy">
                            <div class="page"
                                style="page-break-after: always; height: 33mm; max-height: 33mm; overflow: hidden; font-family: sans-serif; margin:0; padding:0;">
                                <div class="oe_structure" />
                                <style>
                                    .page, .page *,
                                    .label-grid, .label-grid tr, .label-grid td, .label-grid th {
                                    border: none !important;
                                    border-width: 0 !important;
                                    box-shadow: none !important;
                                    outline: none !important;
                                    }
                                </style>

                                <!-- Tabla principal dividida en 2 columnas -->
                                <table class="label-grid"
                                    style="width:100%; height:118px; max-height:118px; table-layout:fixed; border-collapse:collapse; margin:0; padding:0; border:none;">
                                    <colgroup>
                                        <col style="width:58%;" />
                                        <col style="width:42%;" />
                                    </colgroup>

                                    <!-- ═══ FILA 1: Info (Full Width) ═══ -->
                                    <tr style="height:36px; max-height:36px; border:none;">
                                        <td colspan="2"
                                            style="vertical-align:top; text-align:left; padding:2px 4px 0 4px; overflow:hidden; max-height:36px; border:none;">
                                            <div
                                                style="font-weight:900; font-size:1.1em; line-height:1; color:#1a1a1a; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">
                                                <t t-esc="o.product_id.default_code or ''" />
                                            </div>
                                            <table
                                                style="width:100%; border:none; margin:0; padding:1px 0 0 0; border-collapse:collapse; table-layout:fixed;">
                                                <tr style="border:none;">
                                                    <td
                                                        style="width:85%; font-size:0.50em; line-height:1; font-weight:500; white-space:normal; overflow:hidden; border:none; padding:0; text-align:left; vertical-align:top;">
                                                        <t t-esc="o.product_id.name or ''" />
                                                    </td>
                                                    <td
                                                        style="width:15%; font-size:0.4em; line-height:1; font-weight:500; white-space:nowrap; border:none; padding:0 0 0 2px; text-align:right; vertical-align:top;">
                                                        <t t-if="o.product_id.x_version">V:<span
                                                                t-field="o.product_id.x_version" /></t>
                                                        <t t-else="">V:-</t>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>

                                    <!-- ═══ FILA 2: Imagen (Left) | Barcode producto (Right) ═══ -->
                                    <tr style="height:46px; max-height:46px; border:none;">
                                        <td
                                            style="vertical-align:top; text-align:left; padding:6px 4px 1px 4px; overflow:hidden; border:none;">
                                            <span t-field="o.product_id.image_1920"
                                                t-options='{"widget": "image"}'
                                                style="max-width:44px; max-height:36px; object-fit:contain; display:inline-block; vertical-align:top;" />
                                        </td>
                                        <td
                                            style="vertical-align:middle; text-align:center; padding:1px 2px; overflow:hidden; border:none;">
                                            <div t-if="o.product_id.barcode"
                                                style="width:100%; text-align:center;">
                                                <img
                                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.product_id.barcode, 800, 150)"
                                                    style="width:100%; max-height:28px; display:block;" />
                                                <div t-esc="o.product_id.barcode"
                                                    style="font-size:0.55em; letter-spacing:1px; text-align:center; line-height:1;" />
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- ═══ FILA 3: Logo + OF (Left) | Barcode lote (Right) ═══ -->
                                    <tr style="height:36px; max-height:36px; border:none;">
                                        <td
                                            style="vertical-align:bottom; text-align:left; padding:1px 4px; overflow:hidden; border:none;">
                                            <div style="display: flex; align-items: center; margin-top: 4px;">
                                                <img
                                                    style="max-height:18px; margin-right: 18px; display:inline-block;"
                                                    src="/sonelco_document_format/static/src/img/fav-icon-sonelco.png" />
                                                <div
                                                    style="font-size:0.5em; font-weight:bold; white-space:nowrap; line-height:1;">
                                                    OF: <t t-esc="o.name" />
                                                </div>
                                            </div>
                                        </td>
                                        <td
                                            style="vertical-align:bottom; text-align:center; padding:1px; overflow:hidden; border:none;">
                                            <div t-if="lot_info['barcode_value']"
                                                style="text-align:center;">
                                                <img
                                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', lot_info['barcode_value'], 400, 100)"
                                                    style="width:100%; max-height:24px;" />
                                                <div t-esc="lot_info['code']"
                                                    style="font-size:0.45em; letter-spacing:0.5px; text-align:center; line-height:1;" />
                                            </div>
                                        </td>
                                    </tr>

                                </table>

                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>