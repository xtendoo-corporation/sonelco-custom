<?xml version="1.0" encoding="utf-8" ?>
<odoo>
     <template id="template_facturae_deliverynotes_inherit" inherit_id="l10n_es_facturae.template_facturae">
        <xpath expr="//InvoiceLine/DeliveryNotesReferences" position="replace">
            <DeliveryNotesReferences t-if="line.move_line_ids.picking_id">
                <DeliveryNote>
                    <t t-foreach="line.move_line_ids.picking_id" t-as="picking">
                        <DeliveryNoteNumber t-esc="picking.name"/>
                        <DeliveryNoteDate t-esc="picking.date_done.strftime('%Y-%m-%d')"/>
                    </t>
                </DeliveryNote>
            </DeliveryNotesReferences>
        </xpath>
    </template>
</odoo>
